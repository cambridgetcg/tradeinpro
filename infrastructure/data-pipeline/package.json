{
  "name": "tcg-data-pipeline",
  "version": "1.0.0",
  "description": "AWS CDK infrastructure for TCG price data pipeline and ML training",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "cdk": "cdk",
    "synth": "cdk synth",
    "deploy": "cdk deploy --all",
    "deploy:pipeline": "cdk deploy TcgDataPipelineStack",
    "deploy:api": "cdk deploy TcgApiStack",
    "deploy:orchestration": "cdk deploy TcgOrchestrationStack",
    "diff": "cdk diff",
    "destroy": "cdk destroy --all"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.131",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.6",
    "aws-cdk": "^2.118.0",
    "esbuild": "^0.19.11",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.118.0",
    "constructs": "^10.3.0",
    "@aws-sdk/client-dynamodb": "^3.478.0",
    "@aws-sdk/client-kinesis": "^3.478.0",
    "@aws-sdk/client-s3": "^3.478.0",
    "@aws-sdk/client-secrets-manager": "^3.478.0",
    "@aws-sdk/client-sns": "^3.478.0",
    "@aws-sdk/client-sagemaker-runtime": "^3.478.0",
    "@aws-sdk/client-timestream-query": "^3.478.0",
    "@aws-sdk/client-timestream-write": "^3.478.0",
    "@aws-sdk/util-dynamodb": "^3.478.0",
    "source-map-support": "^0.5.21"
  }
}
