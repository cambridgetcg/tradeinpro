{
  "name": "tcgplayer-scraper-dev",
  "version": "1.0.0",
  "description": "TCGplayer price data scraper with multi-source strategy (OPTCG API, JustTCG API, Direct Scraping)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "tcgplayer-pipeline": "dist/cli.js"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run tests/integration",
    "test:optcg": "tsx scripts/test-optcg-api.ts",
    "test:justtcg": "tsx scripts/test-justtcg-api.ts",
    "test:scraper": "tsx scripts/test-scraper.ts",
    "build": "tsc",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "cli": "tsx src/cli.ts",
    "fetch": "tsx src/cli.ts fetch",
    "transform": "tsx src/cli.ts transform",
    "load": "tsx src/cli.ts load",
    "pipeline": "tsx src/cli.ts run",
    "stats": "tsx src/cli.ts stats"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch": "^3.x",
    "@aws-sdk/client-dynamodb": "^3.x",
    "@aws-sdk/client-s3": "^3.x",
    "@aws-sdk/client-secrets-manager": "^3.x",
    "@aws-sdk/client-sqs": "^3.x",
    "@aws-sdk/s3-request-presigner": "^3.965.0",
    "@aws-sdk/util-dynamodb": "^3.x",
    "@prisma/client": "^5.x",
    "axios": "^1.6.x",
    "bottleneck": "^2.19.x",
    "cheerio": "^1.0.0-rc.12",
    "got": "^14.x",
    "https-proxy-agent": "^7.x",
    "p-queue": "^8.x",
    "playwright": "^1.40.x",
    "puppeteer": "^21.x",
    "puppeteer-extra": "^3.3.x",
    "puppeteer-extra-plugin-stealth": "^2.11.x",
    "user-agents": "^1.1.x",
    "uuid": "^9.x",
    "zod": "^3.x"
  },
  "devDependencies": {
    "@types/node": "^20.x",
    "@typescript-eslint/eslint-plugin": "^6.x",
    "@typescript-eslint/parser": "^6.x",
    "@vitest/coverage-v8": "^1.x",
    "eslint": "^8.x",
    "msw": "^2.x",
    "nock": "^13.x",
    "prettier": "^3.x",
    "prisma": "^5.x",
    "tsx": "^4.x",
    "typescript": "^5.x",
    "vitest": "^1.x"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "tcgplayer",
    "scraper",
    "trading-cards",
    "price-data",
    "one-piece-tcg",
    "optcg-api"
  ]
}
