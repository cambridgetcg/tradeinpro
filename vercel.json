{
  "buildCommand": "prisma generate && npm run build",
  "installCommand": "npm install",
  "framework": null,
  "regions": ["iad1"],
  "functions": {
    "api/index.js": {
      "includeFiles": "build/**"
    }
  },
  "crons": [
    {
      "path": "/api/cron/jp-price-sync",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/cleanup",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/price-snapshot",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/price-sync",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/pricefeed-sync",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/correlation-calc",
      "schedule": "0 3 * * 0"
    }
  ],
  "rewrites": [
    { "source": "/build/client/(.*)", "destination": "/build/client/$1" },
    { "source": "/(.*)", "destination": "/api/index.js" }
  ]
}
