{% comment %}
  My Submissions Block
  Shows customer's trade-in history when logged in
{% endcomment %}

<div class="trade-in-account" data-my-submissions data-api-base="/apps/trade-in">
  {% if customer %}
    {%- comment -%} Logged-in customer view {%- endcomment -%}
    <input type="hidden" data-customer-id value="{{ customer.id }}">

    <div class="trade-in-account__header">
      <div class="trade-in-account__header-content">
        <h2 class="trade-in-account__title">{{ block.settings.title | default: 'trade_in.account.title' | t }}</h2>
        <p class="trade-in-account__subtitle">{{ 'trade_in.account.subtitle' | t }}</p>
      </div>
      {% assign trade_in_url = block.settings.trade_in_page | default: '/pages/trade-in' %}
      <a href="{{ trade_in_url }}" class="trade-in-btn trade-in-btn--primary">
        <svg viewBox="0 0 20 20" fill="currentColor" width="16" height="16">
          <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd"/>
        </svg>
        {{ 'trade_in.account.new_trade_in' | t }}
      </a>
    </div>

    {%- comment -%} Stats Cards {%- endcomment -%}
    <div class="trade-in-account__stats" data-account-stats>
      <div class="trade-in-stat-card">
        <span class="trade-in-stat-card__value" data-stat-total>-</span>
        <span class="trade-in-stat-card__label">{{ 'trade_in.account.stats.total' | t }}</span>
      </div>
      <div class="trade-in-stat-card">
        <span class="trade-in-stat-card__value" data-stat-pending>-</span>
        <span class="trade-in-stat-card__label">{{ 'trade_in.account.stats.pending' | t }}</span>
      </div>
      <div class="trade-in-stat-card">
        <span class="trade-in-stat-card__value" data-stat-completed>-</span>
        <span class="trade-in-stat-card__label">{{ 'trade_in.account.stats.completed' | t }}</span>
      </div>
      <div class="trade-in-stat-card trade-in-stat-card--highlight">
        <span class="trade-in-stat-card__value" data-stat-earned>-</span>
        <span class="trade-in-stat-card__label">{{ 'trade_in.account.stats.earned' | t }}</span>
      </div>
    </div>

    {%- comment -%} Filter Tabs {%- endcomment -%}
    <div class="trade-in-account__filters">
      <button type="button" class="trade-in-filter-tab trade-in-filter-tab--active" data-filter="all">
        {{ 'trade_in.account.filter.all' | t }}
      </button>
      <button type="button" class="trade-in-filter-tab" data-filter="pending">
        {{ 'trade_in.account.filter.pending' | t }}
      </button>
      <button type="button" class="trade-in-filter-tab" data-filter="completed">
        {{ 'trade_in.account.filter.completed' | t }}
      </button>
    </div>

    {%- comment -%} Submissions List {%- endcomment -%}
    <div class="trade-in-account__list" data-submissions-list>
      <div class="trade-in-account__loading" data-loading-state>
        <div class="trade-in-spinner"></div>
        <p>{{ 'trade_in.account.loading' | t }}</p>
      </div>
    </div>

    {%- comment -%} Empty State {%- endcomment -%}
    <div class="trade-in-account__empty" data-empty-state hidden>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="trade-in-account__empty-icon">
        <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z"/>
      </svg>
      <h3>{{ 'trade_in.account.empty.title' | t }}</h3>
      <p>{{ 'trade_in.account.empty.message' | t }}</p>
      <a href="{{ trade_in_url }}" class="trade-in-btn trade-in-btn--primary">
        {{ 'trade_in.account.empty.cta' | t }}
      </a>
    </div>

    {%- comment -%} Pagination {%- endcomment -%}
    <div class="trade-in-account__pagination" data-pagination hidden>
      <button type="button" class="trade-in-btn trade-in-btn--secondary" data-load-more>
        {{ 'trade_in.account.load_more' | t }}
      </button>
    </div>

    {%- comment -%} Submission Detail Modal {%- endcomment -%}
    <div class="trade-in-detail-modal" data-detail-modal hidden>
      <div class="trade-in-detail-modal__backdrop" data-modal-backdrop></div>
      <div class="trade-in-detail-modal__container">
        <div class="trade-in-detail-modal__content" data-modal-content>
          {%- comment -%} Content populated by JS {%- endcomment -%}
        </div>
      </div>
    </div>

  {% else %}
    {%- comment -%} Guest view - prompt to login {%- endcomment -%}
    <div class="trade-in-account trade-in-account--guest">
      <div class="trade-in-account__guest-content">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="trade-in-account__guest-icon">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"/>
        </svg>
        <h2 class="trade-in-account__title">{{ block.settings.title | default: 'trade_in.account.title' | t }}</h2>
        <p class="trade-in-account__guest-message">{{ 'trade_in.account.guest.message' | t }}</p>
        <div class="trade-in-account__guest-actions">
          <a href="/account/login?return_url={{ request.path | url_encode }}" class="trade-in-btn trade-in-btn--primary">
            {{ 'trade_in.account.guest.login' | t }}
          </a>
          <a href="/account/register" class="trade-in-btn trade-in-btn--secondary">
            {{ 'trade_in.account.guest.register' | t }}
          </a>
        </div>
        <p class="trade-in-account__guest-track">
          {{ 'trade_in.account.guest.track_prompt' | t }}
          <a href="{{ block.settings.track_page | default: '/pages/track-trade-in' }}">
            {{ 'trade_in.account.guest.track_link' | t }}
          </a>
        </p>
      </div>
    </div>
  {% endif %}
</div>

<script src="{{ 'trade-in-account.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "My Trade-Ins",
  "target": "section",
  "stylesheet": "trade-in.css",
  "enabled_on": {
    "templates": ["customers/account", "page", "index"]
  },
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "My Trade-Ins"
    },
    {
      "type": "url",
      "id": "trade_in_page",
      "label": "Trade-In Page URL"
    },
    {
      "type": "url",
      "id": "track_page",
      "label": "Track Page URL"
    }
  ]
}
{% endschema %}
