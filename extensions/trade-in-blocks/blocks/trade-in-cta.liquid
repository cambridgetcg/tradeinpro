{% comment %}
  Trade-In CTA Block
  Call-to-action button with key features
{% endcomment %}

<div class="trade-in-cta">
  <h2 class="trade-in-cta__title">
    {{ block.settings.title | default: 'trade_in.cta.title' | t }}
  </h2>
  <p class="trade-in-cta__description">
    {{ block.settings.description | default: 'trade_in.cta.description' | t }}
  </p>

  <a href="{{ block.settings.link | default: pages['trade-in'].url | default: '/pages/trade-in' }}" class="trade-in-cta__button">
    {{ block.settings.button_text | default: 'trade_in.cta.button' | t }}
  </a>

  {% if block.settings.show_features %}
    <div class="trade-in-cta__features">
      <div class="trade-in-cta__feature">
        <span class="trade-in-cta__feature-title">{{ 'trade_in.cta.features.fast' | t }}</span>
        <span class="trade-in-cta__feature-desc">{{ 'trade_in.cta.features.fast_desc' | t }}</span>
      </div>
      <div class="trade-in-cta__feature">
        <span class="trade-in-cta__feature-title">{{ 'trade_in.cta.features.bonus' | t }}</span>
        <span class="trade-in-cta__feature-desc">{{ 'trade_in.cta.features.bonus_desc' | t }}</span>
      </div>
      <div class="trade-in-cta__feature">
        <span class="trade-in-cta__feature-title">{{ 'trade_in.cta.features.free_ship' | t }}</span>
        <span class="trade-in-cta__feature-desc">{{ 'trade_in.cta.features.free_ship_desc' | t }}</span>
      </div>
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Trade-In CTA",
  "target": "section",
  "stylesheet": "trade-in.css",
  "enabled_on": {
    "templates": ["*"]
  },
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Trade In Your Cards"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Description",
      "default": "Turn your trading cards into cash or store credit"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Start Trade-In"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Button Link"
    },
    {
      "type": "checkbox",
      "id": "show_features",
      "label": "Show Features",
      "default": true
    }
  ]
}
{% endschema %}
