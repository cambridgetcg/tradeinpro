  trainedAt           DateTime @default(now()) @map("trained_at") @db.Timestamptz
  deployedAt          DateTime? @map("deployed_at") @db.Timestamptz
  retiredAt           DateTime? @map("retired_at") @db.Timestamptz
  notes               String?

  @@map("neural_model_history")
}

// Model performance metrics for monitoring
model NeuralModelMetrics {
  id                  String   @id @default(cuid())

  // Card and prediction info
  cardId              String   @map("card_id")
  modelVersion        String   @map("model_version")

  // Predicted values
  predictedDealType   String?  @map("predicted_deal_type")
  predictedConfidence Decimal? @map("predicted_confidence") @db.Decimal(5, 4)
  predictedReturn     Decimal? @map("predicted_return") @db.Decimal(8, 4)

  // Actual outcomes (filled in later)
  actualDealType      String?  @map("actual_deal_type")
