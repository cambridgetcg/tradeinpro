  priceTimestamp  DateTime @map("price_timestamp")
  collectedAt     DateTime @default(now()) @map("collected_at")

  @@unique([cardId, priceTimestamp], map: "idx_justtcg_history_unique")
  @@index([cardId, priceTimestamp(sort: Desc)], map: "idx_justtcg_history_card")
  @@map("justtcg_price_history")
}

// User feedback for model training
model TrainingFeedback {
  id               Int       @id @default(autoincrement())
  feedbackType     String    @map("feedback_type") @db.VarChar(50)

  // Reference to source data
  referenceId      String?   @map("reference_id") @db.VarChar(100)
  referenceType    String?   @map("reference_type") @db.VarChar(50)

  // Feedback data (JSON for flexibility)
  feedbackData     Json      @map("feedback_data")

  // User info
  userId           String?   @map("user_id") @db.VarChar(100)
  userAccuracyScore Decimal? @map("user_accuracy_score") @db.Decimal(3, 2)

  // Quality control
  isVerified       Boolean   @default(false) @map("is_verified")
  verificationSource String? @map("verification_source") @db.VarChar(50)

  // Timestamps
  createdAt        DateTime  @default(now()) @map("created_at")
  verifiedAt       DateTime? @map("verified_at")

  @@index([feedbackType, createdAt(sort: Desc)], map: "idx_training_feedback_type")
  @@index([referenceType, referenceId], map: "idx_training_feedback_reference")
  @@index([isVerified, feedbackType], map: "idx_training_feedback_verified")
  @@map("training_feedback")
}

// User trade history for outcome tracking
model TradeLog {
  id               Int       @id @default(autoincrement())
  cardId           String    @map("card_id") @db.VarChar(50)
  userId           String?   @map("user_id") @db.VarChar(100)

  // Trade details
  action           String    @db.VarChar(10) // 'buy' | 'sell'
  platform         String    @db.VarChar(50)
  price            Decimal   @db.Decimal(10, 2)
  currency         String    @db.VarChar(3)
  priceGbp         Decimal   @map("price_gbp") @db.Decimal(10, 2)
  quantity         Int       @default(1)
  condition        String?   @db.VarChar(10)
  shippingCost     Decimal?  @map("shipping_cost") @db.Decimal(10, 2)
  fees             Decimal?  @db.Decimal(10, 2)

  // Link buy/sell pairs
  linkedTradeId    Int?      @map("linked_trade_id")
  linkedTrade      TradeLog? @relation("LinkedTrades", fields: [linkedTradeId], references: [id])
  linkedFromTrades TradeLog[] @relation("LinkedTrades")

  // Model predictions at time of trade
  modelPredictedReturn Decimal? @map("model_predicted_return") @db.Decimal(6, 4)
  modelConfidence  Decimal?  @map("model_confidence") @db.Decimal(3, 2)

  // Outcome (for closed positions)
  isClosed         Boolean   @default(false) @map("is_closed")
  actualReturn     Decimal?  @map("actual_return") @db.Decimal(6, 4)
  holdingDays      Int?      @map("holding_days")

  // Notes
  notes            String?

  // Timestamps
  tradeDate        DateTime  @map("trade_date") @db.Date
  createdAt        DateTime  @default(now()) @map("created_at")

  @@index([cardId, tradeDate(sort: Desc)], map: "idx_trade_log_card")
  @@index([userId, tradeDate(sort: Desc)], map: "idx_trade_log_user")
  @@index([isClosed, action], map: "idx_trade_log_open")
  @@map("trade_log")
}

// Track data collection job executions
model CollectionJobStatus {
  id                Int       @id @default(autoincrement())
  jobName           String    @map("job_name") @db.VarChar(100)

  // Execution info
  startedAt         DateTime  @map("started_at")
  completedAt       DateTime? @map("completed_at")
  status            String    @default("running") @db.VarChar(20)

  // Results
  recordsProcessed  Int?      @map("records_processed")
  recordsCreated    Int?      @map("records_created")
  recordsUpdated    Int?      @map("records_updated")
  errorsCount       Int       @default(0) @map("errors_count")

  // Error details
  errorMessage      String?   @map("error_message")
  errorDetails      Json?     @map("error_details")

  // Metadata
  metadata          Json?

  @@index([jobName, startedAt(sort: Desc)], map: "idx_collection_job_name")
  @@index([status, startedAt(sort: Desc)], map: "idx_collection_job_status")
  @@map("collection_job_status")
}

// ============================================================================
// ML FEATURE STATISTICS TABLES
// Pre-computed statistics for neural network feature calculation
// ============================================================================

// Daily rarity-level price statistics for percentile_in_rarity feature
model RarityStatistics {
  id              Int      @id @default(autoincrement())
  game            String   @default("onepiece") @db.VarChar(50)
  rarity          String   @db.VarChar(50)

  // Price distribution percentiles (in GBP)
  p10             Decimal  @db.Decimal(10, 2)
  p25             Decimal  @db.Decimal(10, 2)
  p50             Decimal  @db.Decimal(10, 2)
  p75             Decimal  @db.Decimal(10, 2)
  p90             Decimal  @db.Decimal(10, 2)
  p95             Decimal  @db.Decimal(10, 2)
  p99             Decimal  @db.Decimal(10, 2)

  // Momentum metrics
  momentum7d      Decimal? @map("momentum_7d") @db.Decimal(6, 4)
  momentum30d     Decimal? @map("momentum_30d") @db.Decimal(6, 4)

  // Card count in this rarity
  cardCount       Int      @map("card_count")

  // Average price for this rarity
  avgPrice        Decimal  @map("avg_price") @db.Decimal(10, 2)

  // Snapshot timestamp
  snapshotDate    DateTime @map("snapshot_date") @db.Date
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([game, rarity, snapshotDate])
  @@index([game, snapshotDate], map: "idx_rarity_stats_game_date")
  @@index([rarity], map: "idx_rarity_stats_rarity")
  @@map("rarity_statistics")
}

// Daily set-level statistics for set_momentum and correlation features
model SetStatistics {
  id              Int      @id @default(autoincrement())
  game            String   @default("onepiece") @db.VarChar(50)
  setCode         String   @map("set_code") @db.VarChar(20)

  // Price metrics
  avgPrice        Decimal  @map("avg_price") @db.Decimal(10, 2)
  medianPrice     Decimal  @map("median_price") @db.Decimal(10, 2)
  totalMarketCap  Decimal  @map("total_market_cap") @db.Decimal(14, 2)
  minPrice        Decimal? @map("min_price") @db.Decimal(10, 2)
  maxPrice        Decimal? @map("max_price") @db.Decimal(10, 2)

  // Momentum metrics
  momentum7d      Decimal? @map("momentum_7d") @db.Decimal(6, 4)
  momentum30d     Decimal? @map("momentum_30d") @db.Decimal(6, 4)

  // Card count
  cardCount       Int      @map("card_count")

  // Volatility
  volatility7d    Decimal? @map("volatility_7d") @db.Decimal(6, 4)

  // Snapshot timestamp
  snapshotDate    DateTime @map("snapshot_date") @db.Date
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([game, setCode, snapshotDate])
  @@index([game, snapshotDate], map: "idx_set_stats_game_date")
  @@index([setCode], map: "idx_set_stats_set_code")
  @@map("set_statistics")
}

// Daily correlation cache for card-to-set and card-to-rarity correlations
model CardCorrelationCache {
  id                  Int      @id @default(autoincrement())
  cardId              String   @map("card_id") @db.VarChar(100)
  game                String   @default("onepiece") @db.VarChar(50)

  // Correlation coefficients (-1 to 1)
  correlationToSet    Decimal? @map("correlation_to_set") @db.Decimal(5, 4)
  correlationToRarity Decimal? @map("correlation_to_rarity") @db.Decimal(5, 4)
  correlationDeviation Decimal? @map("correlation_deviation") @db.Decimal(5, 4)

  // Sample size used for calculation
  sampleDays          Int      @map("sample_days")

  // Statistical significance
  pValueSet           Decimal? @map("p_value_set") @db.Decimal(8, 6)
  pValueRarity        Decimal? @map("p_value_rarity") @db.Decimal(8, 6)

  // Snapshot timestamp
  snapshotDate        DateTime @map("snapshot_date") @db.Date
  createdAt           DateTime @default(now()) @map("created_at")

  @@unique([cardId, snapshotDate])
  @@index([cardId], map: "idx_card_correlation_card")
  @@index([snapshotDate], map: "idx_card_correlation_date")
  @@map("card_correlation_cache")
}

// Daily volume statistics for relative_volume normalization
model VolumeStatistics {
  id                  Int      @id @default(autoincrement())
  game                String   @default("onepiece") @db.VarChar(50)

  // Average listings counts (for relative_volume calculation)
  avgUsListings       Decimal? @map("avg_us_listings") @db.Decimal(10, 2)
  avgEuListings       Decimal? @map("avg_eu_listings") @db.Decimal(10, 2)
  totalCardsTracked   Int      @map("total_cards_tracked")

  // By rarity averages (JSON map)
  avgListingsByRarity Json?    @map("avg_listings_by_rarity")

  // Snapshot timestamp
  snapshotDate        DateTime @map("snapshot_date") @db.Date
  createdAt           DateTime @default(now()) @map("created_at")

  @@unique([game, snapshotDate])
  @@index([snapshotDate], map: "idx_volume_stats_date")
  @@map("volume_statistics")
}

// ============================================================================
// CARDMARKET PRICE ARCHIVE (Condition + Language Partitioned)
// ============================================================================

// Daily CardMarket price snapshot per card (aggregate across all conditions)
model CardMarketPriceArchive {
  id              Int      @id @default(autoincrement())
  cardId          String   @map("card_id") @db.VarChar(100)
  date            DateTime @db.Date

  // Card metadata (denormalized for query efficiency)
  game            String   @default("onepiece") @db.VarChar(50)
  setCode         String?  @map("set_code") @db.VarChar(20)
  cardNumber      String?  @map("card_number") @db.VarChar(20)
  variantType     String?  @map("variant_type") @db.VarChar(50)
  cardName        String?  @map("card_name") @db.VarChar(500)

  // Aggregate prices (EUR - CardMarket native currency)
  trendPriceEur   Decimal? @map("trend_price_eur") @db.Decimal(10, 2)
  fromPriceEur    Decimal? @map("from_price_eur") @db.Decimal(10, 2)
  avg7PriceEur    Decimal? @map("avg7_price_eur") @db.Decimal(10, 2)
  avg30PriceEur   Decimal? @map("avg30_price_eur") @db.Decimal(10, 2)

  // Converted to GBP (for arbitrage calculations)
  trendPriceGbp   Decimal? @map("trend_price_gbp") @db.Decimal(10, 2)
  fromPriceGbp    Decimal? @map("from_price_gbp") @db.Decimal(10, 2)
  avg7PriceGbp    Decimal? @map("avg7_price_gbp") @db.Decimal(10, 2)
  avg30PriceGbp   Decimal? @map("avg30_price_gbp") @db.Decimal(10, 2)

  // Availability metrics
  totalListings   Int?     @map("total_listings")
  totalSellers    Int?     @map("total_sellers")

  // Price change indicators
  priceChange7d   Decimal? @map("price_change_7d") @db.Decimal(8, 4)
  priceChange30d  Decimal? @map("price_change_30d") @db.Decimal(8, 4)

  // FX rate used
  eurGbpRate      Decimal? @map("eur_gbp_rate") @db.Decimal(12, 6)

  // Source URL for verification
  sourceUrl       String?  @map("source_url") @db.VarChar(500)

  // Scrape metadata
  scrapedAt       DateTime @default(now()) @map("scraped_at")
  scrapeSuccess   Boolean  @default(true) @map("scrape_success")

  // Relations
  conditionPrices CardMarketConditionSnapshot[]

  @@unique([cardId, date], map: "idx_cm_archive_unique")
  @@index([cardId, date(sort: Desc)], map: "idx_cm_archive_card")
  @@index([date(sort: Desc)], map: "idx_cm_archive_date")
  @@index([setCode, date], map: "idx_cm_archive_set")
  @@index([variantType, date], map: "idx_cm_archive_variant")
  @@index([game, date], map: "idx_cm_archive_game")
  @@map("cardmarket_price_archive")
}

// Condition-level price snapshot for detailed analysis
// 7 conditions: MT (Mint), NM (Near Mint), EX (Excellent), GD (Good), LP (Light Played), PL (Played), PO (Poor)
model CardMarketConditionSnapshot {
  id              Int      @id @default(autoincrement())
  archiveId       Int      @map("archive_id")
  cardId          String   @map("card_id") @db.VarChar(100)
  date            DateTime @db.Date

  // Condition (1-7 mapped to codes)
  // 1=MT, 2=NM, 3=EX, 4=GD, 5=LP, 6=PL, 7=PO
  conditionId     Int      @map("condition_id")
  conditionCode   String   @map("condition_code") @db.VarChar(5) // MT, NM, EX, GD, LP, PL, PO

  // Language (primary language for this listing group)
  // 1=English, 2=French, 3=German, 4=Spanish, 5=Italian, 6=Japanese, etc.
  languageId      Int      @default(1) @map("language_id")
  languageCode    String   @default("EN") @map("language_code") @db.VarChar(5)

  // Prices for this condition (EUR)
  fromPriceEur    Decimal? @map("from_price_eur") @db.Decimal(10, 2)
  avgPriceEur     Decimal? @map("avg_price_eur") @db.Decimal(10, 2)
  highPriceEur    Decimal? @map("high_price_eur") @db.Decimal(10, 2)

  // Converted to GBP
  fromPriceGbp    Decimal? @map("from_price_gbp") @db.Decimal(10, 2)
  avgPriceGbp     Decimal? @map("avg_price_gbp") @db.Decimal(10, 2)
  highPriceGbp    Decimal? @map("high_price_gbp") @db.Decimal(10, 2)

  // Availability for this condition
  listingsCount   Int?     @map("listings_count")
  sellersCount    Int?     @map("sellers_count")

  // Relation
  archive         CardMarketPriceArchive @relation(fields: [archiveId], references: [id], onDelete: Cascade)

  @@unique([cardId, date, conditionCode, languageCode], map: "idx_cm_condition_unique")
  @@index([cardId, date, conditionCode], map: "idx_cm_condition_card")
  @@index([date, conditionCode], map: "idx_cm_condition_date")
  @@index([conditionCode, date], map: "idx_cm_condition_code")
  @@index([languageCode, date], map: "idx_cm_condition_lang")
  @@map("cardmarket_condition_snapshot")
}

// Seller listing snapshot for deep market analysis (optional, high volume)
model CardMarketListingSnapshot {
  id              Int      @id @default(autoincrement())
  cardId          String   @map("card_id") @db.VarChar(100)
