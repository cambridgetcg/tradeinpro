// ============================================================================
// API COMMERCIALIZATION INFRASTRUCTURE
// Rate limiting, billing, and access control
// ============================================================================

// API keys for commercial access
model ApiKey {
  id              String   @id @default(cuid())

  // Key details
  keyHash         String   @unique @map("key_hash")   // SHA-256 of actual key
  keyPrefix       String   @map("key_prefix")         // First 8 chars for identification
  name            String

  // Owner
  userId          String?  @map("user_id")
  organization    String?
  email           String

  // Tier & limits
  tier            String   @default("free")  // free, developer, professional, enterprise, neural
  rateLimitDaily  Int      @default(100) @map("rate_limit_daily")
  rateLimitMinute Int      @default(10) @map("rate_limit_minute")

  // Permissions
  allowedEndpoints String[] @default(["*"]) @map("allowed_endpoints")
  allowedGames    String[] @default(["onepiece"]) @map("allowed_games")
  maxHistoryDays  Int      @default(0) @map("max_history_days")
  bulkAccess      Boolean  @default(false) @map("bulk_access")
  webhookAccess   Boolean  @default(false) @map("webhook_access")
  streamingAccess Boolean  @default(false) @map("streaming_access")
  neuralAccess    Boolean  @default(false) @map("neural_access")

  // Lifecycle
  status          String   @default("active")  // active, suspended, revoked
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  expiresAt       DateTime? @map("expires_at") @db.Timestamptz
  lastUsedAt      DateTime? @map("last_used_at") @db.Timestamptz

  // Billing
  stripeCustomerId String? @map("stripe_customer_id")
  billingEmail    String?  @map("billing_email")

  // Usage tracking
  usage           ApiUsage[]
  webhooks        ApiWebhook[]

  @@index([keyHash], map: "idx_api_keys_hash")
  @@index([userId], map: "idx_api_keys_user")
  @@index([status], map: "idx_api_keys_status")
  @@map("api_keys")
}

// API usage tracking for billing and analytics
model ApiUsage {
  id              String   @id @default(cuid())

  // Key reference
  apiKeyId        String   @map("api_key_id")
  apiKey          ApiKey   @relation(fields: [apiKeyId], references: [id])

  // Request details
  endpoint        String
  method          String
  statusCode      Int      @map("status_code")
  responseTimeMs  Int      @map("response_time_ms")

  // Billing
  tier            String
  billableUnits   Int      @default(1) @map("billable_units")

  // Metadata
  ipAddress       String?  @map("ip_address")
  userAgent       String?  @map("user_agent")
  requestTimestamp DateTime @default(now()) @map("request_timestamp") @db.Timestamptz

  @@index([apiKeyId, requestTimestamp], map: "idx_usage_key")
  @@index([apiKeyId, requestTimestamp], map: "idx_usage_billing")
  @@map("api_usage")
}

// Webhook endpoints for price alerts
model ApiWebhook {
  id              String   @id @default(cuid())

  // Key reference
  apiKeyId        String   @map("api_key_id")
  apiKey          ApiKey   @relation(fields: [apiKeyId], references: [id])

  // Webhook configuration
  url             String
