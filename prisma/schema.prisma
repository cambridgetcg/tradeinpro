  @@index([expiresAt], map: "idx_predictions_expiry")
  @@map("neural_predictions")
}

// Store identified market deals
model NeuralDeal {
  id              String   @id @default(cuid())

  // Card identification
  cardId          String   @map("card_id")
  game            String   @default("onepiece")

  // Deal classification
  dealType        String   @map("deal_type")  // ARBITRAGE_CROSS_MARKET, UNDERVALUED_STATISTICAL, etc.
  confidence      Decimal  @db.Decimal(5, 4)
  expectedReturn  Decimal  @map("expected_return") @db.Decimal(8, 4)
  timeHorizon     String   @map("time_horizon")  // IMMEDIATE, SHORT, MEDIUM, LONG
  riskLevel       String   @map("risk_level")    // LOW, MEDIUM, HIGH

  // Action details
  actionType      String   @map("action_type")   // BUY, SELL, BUY_SELL, HOLD
  buyMarket       String?  @map("buy_market")
  buyPrice        Decimal? @map("buy_price") @db.Decimal(10, 2)
  sellMarket      String?  @map("sell_market")
  sellPrice       Decimal? @map("sell_price") @db.Decimal(10, 2)

  // Metadata
  metadata        Json?
  featureImportance Json? @map("feature_importance")

  // Lifecycle
  status          String   @default("ACTIVE")  // ACTIVE, EXECUTED, EXPIRED, CANCELLED
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  expiresAt       DateTime @map("expires_at") @db.Timestamptz
  executedAt      DateTime? @map("executed_at") @db.Timestamptz
  actualReturn    Decimal? @map("actual_return") @db.Decimal(8, 4)  // For model training feedback

  // Annotation fields (for training feedback)
  userRating      String?   @map("user_rating")      // 'good', 'bad', 'uncertain'
  annotationNotes String?   @map("annotation_notes") @db.Text
  annotationTags  String[]  @default([]) @map("annotation_tags")
  annotatedAt     DateTime? @map("annotated_at") @db.Timestamptz
  wasProfitable   Boolean?  @map("was_profitable")
  profitAmount    Decimal?  @map("profit_amount") @db.Decimal(10, 2)

  // Relation to card
  card            CardPriceV2? @relation(fields: [cardId], references: [cardId])

  @@index([cardId], map: "idx_deals_card")
  @@index([dealType, status], map: "idx_deals_type")
  @@index([status, expiresAt], map: "idx_deals_active")
  @@index([confidence], map: "idx_deals_confidence")
  @@map("neural_deals")
}

// Store model training history for versioning and rollback
model NeuralModelHistory {
  id                  String   @id @default(cuid())

  // Model identification
  modelVersion        String   @unique @map("model_version")

  // Training metrics
  trainingSamples     Int      @map("training_samples")
  validationSamples   Int      @map("validation_samples")
  dealTypeAccuracy    Decimal? @map("deal_type_accuracy") @db.Decimal(5, 4)
  confidenceBrierScore Decimal? @map("confidence_brier_score") @db.Decimal(5, 4)
