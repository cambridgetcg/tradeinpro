// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
}

// ============================================================================
// EXISTING TABLES FROM TRADING-CARD-PRICER (DO NOT MODIFY)
// These tables are managed by the Lambda price fetcher
// ============================================================================

// Legacy table - being phased out in favor of CardPriceV2
model ExternalCardPrice {
  cardId             String    @id @map("card_id") @db.VarChar(255)
  name               String    @db.VarChar(500)
  marketPrice        Decimal   @map("market_price") @db.Decimal(10, 2)
  tradeinPrice       Decimal   @map("tradein_price") @db.Decimal(10, 2)
  currency           String    @db.VarChar(10)
  source             String    @db.VarChar(50)
  game               String    @db.VarChar(50)
  shopifyProductId   String?   @map("shopify_product_id") @db.VarChar(255)
  lastUpdated        DateTime? @default(now()) @map("last_updated") @db.Timestamptz
  createdAt          DateTime? @default(now()) @map("created_at") @db.Timestamptz
  isAlternateArt     Boolean?  @default(false) @map("is_alternate_art")
  variantType        String?   @map("variant_type") @db.VarChar(50)
  rarity             String?   @db.VarChar(50)
  printing           String?   @default("Normal") @db.VarChar(50)
  marketPriceGbp     Decimal?  @map("market_price_gbp") @db.Decimal(10, 2)
  tradeinPriceGbp    Decimal?  @map("tradein_price_gbp") @db.Decimal(10, 2)
  exchangeRate       Decimal?  @map("exchange_rate") @db.Decimal(10, 6)
  tcgplayerPriceUsd  Decimal?  @map("tcgplayer_price_usd") @db.Decimal(10, 2)
  tcgplayerPriceGbp  Decimal?  @map("tcgplayer_price_gbp") @db.Decimal(10, 2)
  cardmarketPriceEur Decimal?  @map("cardmarket_price_eur") @db.Decimal(10, 2)
  cardmarketPriceGbp Decimal?  @map("cardmarket_price_gbp") @db.Decimal(10, 2)

  @@index([game], map: "idx_card_prices_game")
  @@index([source], map: "idx_card_prices_source")
  @@index([lastUpdated], map: "idx_card_prices_last_updated")
  @@index([shopifyProductId], map: "idx_card_prices_shopify")
  @@index([isAlternateArt], map: "idx_card_prices_alt_art")
  @@index([variantType], map: "idx_card_prices_variant")
  @@index([marketPriceGbp], map: "idx_card_prices_market_gbp")
  @@index([tradeinPriceGbp], map: "idx_card_prices_tradein_gbp")
  @@index([tcgplayerPriceGbp], map: "idx_card_prices_tcgplayer_gbp")
  @@index([cardmarketPriceGbp], map: "idx_card_prices_cardmarket_gbp")
  @@map("card_prices")
}

// NEW: Normalized card prices table (card_prices_v2)
// One row per unique card+variant, with prices from all sources as columns
// Card ID format: SET-NUMBER or SET-NUMBER-variant (e.g., "OP01-003" or "OP01-003-parallel")
model CardPriceV2 {
  // Primary identifier: {RELEASE_SET}-{FULL_CARD_NUMBER}[-{variant}]
  // e.g., OP03-OP01-051-sp, OP01-OP01-003-parallel
  cardId             String    @id @map("card_id") @db.VarChar(100)

  // Card metadata
  game               String    @default("onepiece") @db.VarChar(50)
  name               String    @db.VarChar(500)
  releaseSet         String?   @map("release_set") @db.VarChar(20) // Booster set where card was released (e.g., OP03)
  fullCardNumber     String?   @map("full_card_number") @db.VarChar(30) // Original card number with set prefix (e.g., OP01-051)
  setCode            String?   @map("set_code") @db.VarChar(20) // Original card's set code (e.g., OP01)
  cardNumber         String?   @map("card_number") @db.VarChar(20) // Card number within set (e.g., 051)
  variantType        String?   @map("variant_type") @db.VarChar(50) // null for base, 'parallel', 'manga', 'sp', etc.
  rarity             String?   @db.VarChar(50)

  // Language (EN, JP, etc.)
  language           String?   @default("EN") @db.VarChar(10)

  // OPTCG API prices (TCGplayer source)
  optcgTcgplayerUsd  Decimal?  @map("optcg_tcgplayer_usd") @db.Decimal(10, 2)
  optcgTcgplayerGbp  Decimal?  @map("optcg_tcgplayer_gbp") @db.Decimal(10, 2)
  optcgUpdatedAt     DateTime? @map("optcg_updated_at") @db.Timestamptz

  // Limitless prices (CardMarket source)
  limitlessCardmarketEur Decimal? @map("limitless_cardmarket_eur") @db.Decimal(10, 2)
  limitlessCardmarketGbp Decimal? @map("limitless_cardmarket_gbp") @db.Decimal(10, 2)
  limitlessUpdatedAt     DateTime? @map("limitless_updated_at") @db.Timestamptz

  // JustTCG prices (TCGplayer source)
  justtcgTcgplayerUsd Decimal?  @map("justtcg_tcgplayer_usd") @db.Decimal(10, 2)
  justtcgTcgplayerGbp Decimal?  @map("justtcg_tcgplayer_gbp") @db.Decimal(10, 2)
  justtcgUpdatedAt    DateTime? @map("justtcg_updated_at") @db.Timestamptz

  // Best/computed prices (lowest of all sources)
  bestPriceGbp       Decimal?  @map("best_price_gbp") @db.Decimal(10, 2)
  tradeinPriceGbp    Decimal?  @map("tradein_price_gbp") @db.Decimal(10, 2)

  // Exchange rates used
  usdToGbpRate       Decimal?  @map("usd_to_gbp_rate") @db.Decimal(10, 6)
  eurToGbpRate       Decimal?  @map("eur_to_gbp_rate") @db.Decimal(10, 6)

  // Shopify integration
  shopifyProductId   String?   @map("shopify_product_id") @db.VarChar(255)

  // Card image URL (local path or CDN URL)
  imageUrl           String?   @map("image_url") @db.VarChar(500)

  // Timestamps
  createdAt          DateTime? @default(now()) @map("created_at") @db.Timestamptz
  lastUpdated        DateTime? @default(now()) @map("last_updated") @db.Timestamptz

  @@index([game], map: "idx_card_prices_v2_game")
  @@index([releaseSet], map: "idx_card_prices_v2_release_set")
  @@index([fullCardNumber], map: "idx_card_prices_v2_full_card_number")
  @@index([setCode], map: "idx_card_prices_v2_set_code")
  @@index([variantType], map: "idx_card_prices_v2_variant")
  @@index([bestPriceGbp], map: "idx_card_prices_v2_best_price")
  @@index([tradeinPriceGbp], map: "idx_card_prices_v2_tradein")
  @@index([name], map: "idx_card_prices_v2_name")
  @@index([shopifyProductId], map: "idx_card_prices_v2_shopify")
  @@index([language], map: "idx_card_prices_v2_language")
  @@map("card_prices_v2")
}

model InventoryAltArt {
  id                 Int       @id @default(autoincrement())
  sku                String    @unique @db.VarChar(100)
  cardType           String    @map("card_type") @db.VarChar(20)
  releaseSet         String    @map("release_set") @db.VarChar(20)
  originalSet        String    @map("original_set") @db.VarChar(20)
  cardNumber         String    @map("card_number") @db.VarChar(10)
  originalCardId     String    @map("original_card_id") @db.VarChar(20)
  jpyPrice           Decimal?  @map("jpy_price") @db.Decimal(10, 2)
  gbpCost            Decimal?  @map("gbp_cost") @db.Decimal(10, 2)
  gbpSelling         Decimal?  @map("gbp_selling") @db.Decimal(10, 2)
  ebayItemNumber     BigInt?   @map("ebay_item_number")
  tcgplayerPriceUsd  Decimal?  @map("tcgplayer_price_usd") @db.Decimal(10, 2)
  tcgplayerPriceGbp  Decimal?  @map("tcgplayer_price_gbp") @db.Decimal(10, 2)
  cardmarketPriceEur Decimal?  @map("cardmarket_price_eur") @db.Decimal(10, 2)
  cardmarketPriceGbp Decimal?  @map("cardmarket_price_gbp") @db.Decimal(10, 2)
  createdAt          DateTime? @default(now()) @map("created_at") @db.Timestamptz
  lastUpdated        DateTime? @default(now()) @map("last_updated") @db.Timestamptz

  @@index([cardType], map: "idx_inventory_alt_art_card_type")
  @@index([releaseSet], map: "idx_inventory_alt_art_release_set")
  @@index([originalCardId], map: "idx_inventory_alt_art_original_card_id")
  @@map("inventory_alt_art")
}

// Japanese card price source (imported from CSV/Excel)
// Used to store Japanese card prices before syncing to CardPriceV2
model JapanesePriceSource {
  id                 String    @id @default(cuid())

  // Card identification (matches Shopify SKU format)
  sku                String    @unique @db.VarChar(100)  // e.g., "OP01-003-P"

  // Card metadata (from CSV)
  name               String    @db.VarChar(500)
  setCode            String?   @map("set_code") @db.VarChar(20)
  cardNumber         String?   @map("card_number") @db.VarChar(20)
  variantType        String?   @map("variant_type") @db.VarChar(50)
  rarity             String?   @db.VarChar(50)

  // Pricing (from CSV)
  priceJpy           Int?      @map("price_jpy")           // Original JPY price
  priceGbp           Int?      @map("price_gbp")           // Converted/provided GBP (pence)
  tradeinPriceGbp    Int?      @map("tradein_price_gbp")   // Trade-in price (pence)

  // Exchange rate used
  jpyToGbpRate       Decimal?  @map("jpy_to_gbp_rate") @db.Decimal(10, 6)

  // Source tracking
  source             String    @default("csv_import") @db.VarChar(50)
  sourceRowId        String?   @map("source_row_id") @db.VarChar(100)

  // Sync status
  syncedToCardPrice  Boolean   @default(false) @map("synced_to_card_price")
  cardPriceV2Id      String?   @map("card_price_v2_id") @db.VarChar(100)

  // Timestamps
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([setCode], map: "idx_jp_price_set_code")
  @@index([syncedToCardPrice], map: "idx_jp_price_synced")
  @@index([name], map: "idx_jp_price_name")
  @@map("japanese_price_source")
}

// ============================================================================
// TRADE-IN SYSTEM MODELS
// ============================================================================

// Card prices fed from external source / managed by merchant
model CardPrice {
  id          String   @id @default(cuid())
  sku         String?  @unique // External SKU e.g., "optcg-op03-001-en"
  cardName    String
  setName     String
  setCode     String?
  rarity      String?
  cardNumber  String?
  variant     String?  // e.g., "Holo", "Reverse Holo", "1st Edition"

  // Prices by condition (in cents to avoid floating point issues)
  priceNM     Int      @default(0)  // Near Mint
  priceLP     Int      @default(0)  // Lightly Played
  priceMP     Int      @default(0)  // Moderately Played
  priceHP     Int      @default(0)  // Heavily Played
  priceDMG    Int      @default(0)  // Damaged

  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tradeInItems TradeInItem[]

  @@index([cardName])
  @@index([setName])
  @@index([setCode])
  @@index([sku])
}

// Customer submitting trade-ins (linked to Shopify customer if available)
model Customer {
  id                 String   @id @default(cuid())
  shopifyCustomerId  String?  @unique
  email              String
  firstName          String?
  lastName           String?
  phone              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  submissions   TradeInSubmission[]
  payoutMethods PayoutMethod[]
  payouts       Payout[]
}

// Customer's saved payout methods
model PayoutMethod {
  id            String   @id @default(cuid())
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id])

  type          String   // BANK, PAYPAL

  // Bank details
  bankName      String?
  accountName   String?
  bsb           String?
  accountNumber String?

  // PayPal details
  paypalEmail   String?

  isDefault     Boolean  @default(false)
  isVerified    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([customerId])
}

// Main trade-in submission
model TradeInSubmission {
  id               String   @id @default(cuid())
  submissionNumber String   @unique
  customerId       String
  customer         Customer @relation(fields: [customerId], references: [id])

  status           String   @default("DRAFT")
  // DRAFT, SUBMITTED, IN_TRANSIT, RECEIVED, GRADING,
  // PENDING_APPROVAL, APPROVED, COMPLETED, CANCELLED, RETURNED

  // Payout preference
  payoutType       String   @default("STORE_CREDIT") // STORE_CREDIT, BANK, PAYPAL

  // Bank details (for BANK payout type)
  bankAccountName   String?  // Name on the account
  bankSortCode      String?  // UK sort code (XX-XX-XX)
  bankAccountNumber String?  // UK account number (8 digits)

  // Customer contact preferences
  phone            String?  // Customer phone number for this submission
  contactChannel   String?  // WHATSAPP, TELEGRAM, SIGNAL

  // Totals (in cents)
  quotedTotal      Int      @default(0)
  finalTotal       Int?
  bonusAmount      Int      @default(0)

  // Shipping
  shippingMethod   String?  // PREPAID, SELF_SHIP, DROP_OFF
  trackingNumber   String?
  labelUrl         String?

  // Customer shipping address (for prepaid labels)
  shippingName        String?
  shippingAddress1    String?
  shippingAddress2    String?
  shippingCity        String?
  shippingPostalCode  String?
  shippingCountry     String?  @default("GB")

  // Royal Mail integration
  royalMailOrderId    String?  // Royal Mail order reference
  labelPdfBase64      String?  @db.Text // Base64 encoded PDF label
  labelGeneratedAt    DateTime?
  carrier             String?  // e.g., "Royal Mail"

  // Timestamps
  submittedAt      DateTime?
  receivedAt       DateTime?
  gradedAt         DateTime?
  approvedAt       DateTime?
  completedAt      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  items   TradeInItem[]
  notes   SubmissionNote[]
  payout  Payout?

  @@index([customerId])
  @@index([status])
  @@index([submissionNumber])
  @@index([status, createdAt])      // Status filtering with sort
  @@index([customerId, status])     // Customer's submissions by status
  @@index([payoutType, status])     // Payout queue filtering
}

// Individual cards in a submission
model TradeInItem {
  id              String   @id @default(cuid())
  submissionId    String
  submission      TradeInSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  cardPriceId     String?
  cardPrice       CardPrice? @relation(fields: [cardPriceId], references: [id])

  // Card details (denormalized for history)
  cardName        String
  setName         String
  setCode         String?
  variant         String?

  quantity        Int      @default(1)

  // Condition
  conditionClaimed String  // NM, LP, MP, HP, DMG
  conditionActual  String? // Set during grading

  // Prices (in pence)
  marketPricePence Int?     // Base market price for condition calculations
  quotedPrice     Int      @default(0)
  finalPrice      Int?

  adjustmentReason String?

  status          String   @default("PENDING")
  // PENDING, VERIFIED, ADJUSTED, REJECTED

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([submissionId])
  @@index([cardPriceId])
  @@index([status, createdAt])      // Item status tracking
}

// Notes/communication on submissions
model SubmissionNote {
  id           String   @id @default(cuid())
  submissionId String
  submission   TradeInSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  authorType   String   // CUSTOMER, MERCHANT, SYSTEM
  authorName   String?
  message      String
  isInternal   Boolean  @default(false) // Internal notes not shown to customer

  createdAt    DateTime @default(now())

  @@index([submissionId])
}

// Payout records
model Payout {
  id           String   @id @default(cuid())
  submissionId String   @unique
  submission   TradeInSubmission @relation(fields: [submissionId], references: [id])
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id])

  type         String   // STORE_CREDIT, BANK, PAYPAL

  amount       Int      // Base amount in cents
  bonusAmount  Int      @default(0)
  totalAmount  Int      // Final payout amount

  status       String   @default("PENDING")
  // PENDING, PROCESSING, COMPLETED, FAILED

  // Store credit details
  giftCardId   String?
  giftCardCode String?

  // Bank transfer details
  bankReference String?

  processedAt  DateTime?
  failureReason String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([customerId])
  @@index([status])
}

// App settings per shop
model TradeInSettings {
  id                    String   @id @default(cuid())
  shop                  String?  @unique

  // Value thresholds (in cents)
  minimumSubmissionValue Int     @default(500)  // £5 minimum
  requiresApprovalAbove  Int     @default(5000) // £50+ requires approval
  autoApproveBelow       Int     @default(2000) // Auto-approve under £20
  maxItemsPerSubmission  Int     @default(100)

  // Payout settings
  storeCreditBonusPercent Int    @default(10)  // 10% bonus for store credit
  cashPayoutPercent       Int    @default(100) // 100% = full trade-in value

  // Condition multipliers (as decimals, e.g., 0.70 = 70%)
  conditionMultiplierNM  Float   @default(0.70)
  conditionMultiplierLP  Float   @default(0.55)
  conditionMultiplierMP  Float   @default(0.40)
  conditionMultiplierHP  Float   @default(0.25)
  conditionMultiplierDMG Float   @default(0.10)

  // Shipping
  freeShippingMinimum    Int     @default(5000) // Free label if > £50
  shippingLabelEnabled   Boolean @default(true)
  returnAddress          String? // JSON string

  // Royal Mail integration
  royalMailEnabled       Boolean @default(false)
  royalMailService       String  @default("TPN") // TPN = Tracked 48

  // Notifications
  notifyOnSubmission     Boolean @default(true)
  notifyOnReceived       Boolean @default(true)
  notifyOnGraded         Boolean @default(true)

  // Content
  termsAndConditions     String?
  gradingGuideUrl        String?

  // CTA Block Settings (synced to Shopify metafields)
  ctaTitle               String?  @map("cta_title")
  ctaDescription         String?  @map("cta_description")
  ctaButtonText          String?  @map("cta_button_text")
  ctaButtonLink          String?  @map("cta_button_link")
  ctaShowFeatures        Boolean  @default(true) @map("cta_show_features")
  ctaFeature1Title       String?  @map("cta_feature_1_title")
  ctaFeature1Desc        String?  @map("cta_feature_1_desc")
  ctaFeature2Title       String?  @map("cta_feature_2_title")
  ctaFeature2Desc        String?  @map("cta_feature_2_desc")
  ctaFeature3Title       String?  @map("cta_feature_3_title")
  ctaFeature3Desc        String?  @map("cta_feature_3_desc")

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

// Excluded cards from trade-in system
// Cards in this list will be skipped during price sync
model ExcludedTradeInCard {
  sku         String   @id                    // SKU to exclude (e.g., "OP-OP11-SP-OP05-119-JP")
  reason      String?                         // Optional reason for exclusion
  excludedAt  DateTime @default(now()) @map("excluded_at")
  excludedBy  String?  @map("excluded_by")    // Who excluded it (admin email/name)

  @@map("excluded_trade_in_cards")
}

// Idempotency tracking for duplicate submission prevention
// Records expire after 24 hours and should be cleaned up periodically
model IdempotencyRecord {
  id              String   @id @default(cuid())

  // Client-provided idempotency key (UUID)
  idempotencyKey  String   @unique @map("idempotency_key")

  // Content-based fingerprint (SHA-256 hash of email + normalized items)
  contentHash     String?  @map("content_hash")

  // Associated submission (if created successfully)
  submissionId    String?  @map("submission_id")

  // Request metadata
  customerId      String?  @map("customer_id")
  email           String

  // Cached response for duplicate requests
  responseStatus  Int      @default(201) @map("response_status")
  responseBody    String?  @map("response_body") @db.Text

  // Timestamps
  createdAt       DateTime @default(now()) @map("created_at")
  expiresAt       DateTime @map("expires_at")

  @@index([contentHash], map: "idx_idempotency_content_hash")
  @@index([email, createdAt], map: "idx_idempotency_email_created")
  @@index([expiresAt], map: "idx_idempotency_expires")
  @@map("idempotency_records")
}

// ============================================================================
// PRICE INDEX SYSTEM (PRISM)
// Market intelligence and trend tracking
// ============================================================================

// Daily snapshot of index values for tracking trends
model PriceIndexSnapshot {
  id            String   @id @default(cuid())

  // Index identification
  indexType     String   @map("index_type")  // GAME, SET, RARITY, TOP_100, LANGUAGE, VOLATILITY
  indexKey      String   @map("index_key")   // "onepiece", "OP01", "SR", "EN", etc.

  // Core metrics
  value         Decimal  @db.Decimal(12, 4)  // Index value
  change24h     Decimal  @default(0) @map("change_24h") @db.Decimal(8, 4)   // 24h change %
  change7d      Decimal  @default(0) @map("change_7d") @db.Decimal(8, 4)    // 7d change %
  change30d     Decimal  @default(0) @map("change_30d") @db.Decimal(8, 4)   // 30d change %

  // Volume metrics
  cardCount     Int      @map("card_count")                          // Cards in index
  totalMarketCap Decimal @map("total_market_cap") @db.Decimal(14, 2) // Total value in GBP
  avgPrice      Decimal  @map("avg_price") @db.Decimal(10, 2)        // Average card price

  // Volatility metrics
  volatility    Decimal  @default(0) @db.Decimal(8, 4)   // Std dev of prices
  highPrice     Decimal  @map("high_price") @db.Decimal(10, 2)  // Highest card
  lowPrice      Decimal  @map("low_price") @db.Decimal(10, 2)   // Lowest card

  // Timestamps
  snapshotDate  DateTime @map("snapshot_date") @db.Date
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([indexType, indexKey, snapshotDate])
  @@index([indexType, snapshotDate], map: "idx_price_index_type_date")
  @@index([indexKey], map: "idx_price_index_key")
  @@map("price_index_snapshots")
}

// Card-level price history for detailed trend analysis
model CardPriceHistory {
  id           String   @id @default(cuid())

  // Card identification
  cardId       String   @map("card_id")      // References CardPriceV2.cardId
  game         String   @default("onepiece")
  setCode      String?  @map("set_code")

  // Price snapshot
  priceGbp     Decimal  @map("price_gbp") @db.Decimal(10, 2)
  sourceUsed   String   @map("source_used")  // Which source provided the price (optcg, limitless, justtcg)

  // Change from previous day
  change       Decimal  @default(0) @db.Decimal(8, 4)  // % change from previous

  // Timestamp
  snapshotDate DateTime @map("snapshot_date") @db.Date

  @@unique([cardId, snapshotDate])
  @@index([cardId, snapshotDate], map: "idx_card_history_id_date")
  @@index([game, snapshotDate], map: "idx_card_history_game_date")
  @@index([setCode, snapshotDate], map: "idx_card_history_set_date")
  @@map("card_price_history")
}

// Correlation tracking between cards/sets for neural network visualization
model PriceCorrelation {
  id            String   @id @default(cuid())

  // Entity pair (can be card IDs or set codes)
  entityA       String   @map("entity_a")
  entityB       String   @map("entity_b")
  entityType    String   @default("card") @map("entity_type")  // "card" or "set"

  // Correlation coefficient (-1 to 1)
  correlation   Decimal  @db.Decimal(5, 4)

  // Statistical metadata
  sampleSize    Int      @map("sample_size")  // Days of data used
  pValue        Decimal? @map("p_value") @db.Decimal(8, 6)  // Statistical significance

  // Timestamps
  calculatedAt  DateTime @default(now()) @map("calculated_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([entityA, entityB])
  @@index([entityA], map: "idx_correlation_entity_a")
  @@index([entityB], map: "idx_correlation_entity_b")
  @@index([correlation], map: "idx_correlation_value")
  @@map("price_correlations")
}
