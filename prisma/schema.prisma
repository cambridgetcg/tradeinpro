// ============================================================================
// NEURAL NETWORK DEAL IDENTIFICATION SYSTEM
// AI-powered market intelligence and deal detection
// ============================================================================

// Store model predictions with confidence intervals
model NeuralPrediction {
  id              String   @id @default(cuid())

  // Card identification
  cardId          String   @map("card_id")
  game            String   @default("onepiece")

  // Price predictions
  price24h        Decimal? @map("price_24h") @db.Decimal(10, 2)
  price7d         Decimal? @map("price_7d") @db.Decimal(10, 2)
  price30d        Decimal? @map("price_30d") @db.Decimal(10, 2)

  // Confidence intervals (0-1)
  confidence24h   Decimal? @map("confidence_24h") @db.Decimal(5, 4)
  confidence7d    Decimal? @map("confidence_7d") @db.Decimal(5, 4)
  confidence30d   Decimal? @map("confidence_30d") @db.Decimal(5, 4)

  // Model metadata
  modelVersion    String   @map("model_version")
  featureVector   Json?    @map("feature_vector") // Stored for explainability

